# Shared Spotify Client ID (always available as fallback)
VITE_SPOTIFY_CLIENT_ID_SHARED=65b708073fc0480ea92a077233ca87bd

# Your own Spotify Client ID (optional - overrides shared)
# To get your own:
# 1. Go to https://developer.spotify.com/dashboard
# 2. Click "Create App"
# 3. Set Redirect URI to your relay URL (e.g., https://nshosting.nl/spotify.php)
# 4. Check "Web API" and "Web Playback SDK"
# 5. Copy the Client ID from app settings
VITE_SPOTIFY_CLIENT_ID=5aaf5ad8ff144042924760bde3e3b072

# Auth relay URL for PKCE with custom client ID (optional)
# Host spotify-relay.php on your HTTPS server and set the URL here
# NOTE: If not using relay, set redirect URI in Spotify Dashboard to: http://127.0.0.1:5000/auth/callback
VITE_AUTH_RELAY_URL=https://nswebhosting.nl/spotify.php

# Dev mode - shows debug info under progress bar
VITE_DEV_MODE=false

# Skip tutorial on first run
VITE_SKIP_TUTORIAL=true

# Disable analytics by default
VITE_ANALYTICS_ENABLED=false

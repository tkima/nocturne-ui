# Shared Spotify Client ID (always available as fallback)
VITE_SPOTIFY_CLIENT_ID_SHARED=65b708073fc0480ea92a077233ca87bd

# Your own Spotify Client ID (optional - overrides shared)
# To get your own:
# 1. Go to https://developer.spotify.com/dashboard
# 2. Click "Create App"
# 3. Set Redirect URI to your relay URL (e.g., https://yoursite.com/spotify.php)
# 4. Check "Web API" and "Web Playback SDK"
# 5. Copy the Client ID from app settings
VITE_SPOTIFY_CLIENT_ID=

# Auth relay URL for PKCE with custom client ID (optional)
# Host spotify-relay.php on your HTTPS server and set the URL here
# NOTE: If not using relay, set redirect URI in Spotify Dashboard to: http://127.0.0.1:5000/auth/callback
VITE_AUTH_RELAY_URL=

# Redirect URI for OAuth callback (optional, fallback)
# In dev: defaults to http://127.0.0.1:5000/auth/callback
VITE_REDIRECT_URI=

# Skip tutorial on first load (for development)
VITE_SKIP_TUTORIAL=true

# Dial/knob action: true = skip 10s, false = volume control
VITE_DIAL_SEEK_ENABLED=true

# Analytics: true = enabled (default), false = disabled
VITE_ANALYTICS_ENABLED=false

# Bluetooth: true = enabled (default), false = disabled
# Set to false to disable Bluetooth pairing/reconnection features
VITE_BLUETOOTH_ENABLED=true

# Debug overlay: true = show debug panel, false = hidden
VITE_DEBUG_ENABLED=false
